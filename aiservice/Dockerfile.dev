FROM maven:3.9.16-eclipse-temurin-25-alpine

WORKDIR /app

RUN apk add --no-cache curl

COPY pom.xml ./
COPY commonlib/pom.xml ./commonlib/pom.xml
COPY commonlib/src ./commonlib/src
COPY carservice/pom.xml ./carservice/pom.xml
COPY aiservice/pom.xml ./aiservice/pom.xml
RUN mvn --batch-mode --no-transfer-progress -pl commonlib install -DskipTests
COPY aiservice/src ./aiservice/src

WORKDIR /app/aiservice

EXPOSE 8081

CMD ["mvn", "--batch-mode", "--no-transfer-progress", "spring-boot:run"]

FROM maven:3.9.16-eclipse-temurin-25-alpine AS builder

WORKDIR /app

COPY pom.xml ./
COPY service-parent/pom.xml ./service-parent/pom.xml
COPY commonlib/pom.xml ./commonlib/pom.xml
COPY commonlib/src ./commonlib/src
COPY carservice/pom.xml ./carservice/pom.xml
COPY aiservice/pom.xml ./aiservice/pom.xml
COPY aiservice/src ./aiservice/src
RUN mvn --batch-mode --no-transfer-progress -pl aiservice -am package -DskipTests \
    && cp aiservice/target/aiservice-*.jar application.jar

FROM eclipse-temurin:25-jre-alpine

WORKDIR /app

RUN apk add --no-cache curl \
    && addgroup -S spring \
    && adduser -S spring -G spring

COPY --from=builder --chown=spring:spring /app/application.jar ./application.jar

USER spring
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "application.jar"]
